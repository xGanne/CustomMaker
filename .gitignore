# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv311/
venv/
env/

# ── App web (web/) ────────────────────────────────────────────────────
node_modules/
# web/dist é coberto por dist/ abaixo

# ── Build do exe (PyInstaller) ────────────────────────────────────────
# o exe oficial é gerado pelo CI; build/ e dist/ são só de builds locais
build/
dist/
*.spec
!CustomMaker.spec

# ── Testes e ferramentas ──────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
# relatórios gerados pelo CI
test-report.xml
pytest-output.txt
pytest-output-crash.txt
selftest-report.txt

# ── Estado do app rodando pelo código-fonte ───────────────────────────
# (no exe fica em %LOCALAPPDATA%\CustomMaker; ver src/utils/resource_loader.py)
.env
config.env
custommaker_config.json
presets.json
imported_posts.json
imported_posts.json.tmp
session.json
session.json.tmp
session_edits/
updates/
logs/
*.log
# caches: miniaturas/visualizador do Danbooru e ícones SVG do tema
.cache/
.ui/

# ── Outros ────────────────────────────────────────────────────────────
logo.ico
